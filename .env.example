# Copy to .env.local for local development (gitignored).
# Set these as EAS secrets for production builds:
#   eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value "..."
#   eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value "..."
#   eas secret:create --name EXPO_PUBLIC_SYNQ_SHARE_BASE --value "https://new-synq-main.web.app"

# Required for production crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# Optional: enable Sentry in dev builds
EXPO_PUBLIC_SENTRY_ENABLE_DEV=0

# Google Maps (client-side place enrichment)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase (optional overrides; defaults in src/lib/config.js)
EXPO_PUBLIC_FIREBASE_API_KEY=
# Phone auth SMS branding: auth.synqapp.com (fallback in config.js)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Profile share links for link-preview unfurling (defaults to free Firebase Hosting URL).
# Production branding: https://join.synq.app/u/{inviteCode}
# Free option (no custom domain): https://new-synq-main.web.app/u/{inviteCode}
EXPO_PUBLIC_SYNQ_SHARE_BASE=

# Used by npm run setup:share-domain before Firebase Hosting deploy
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINT=

# Cloud Functions (set in Firebase / Secret Manager — not Expo):
# PHONE_LOOKUP_SECRET=  # HMAC secret for contact phone matching (required in production)
